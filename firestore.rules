rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: any signed-in user can read; only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30;
      allow update: if request.auth.uid == uid && request.resource.data.name.size() <= 30;
      allow delete: if false;
    }

    // One-to-one chats. Chat id = "uidA_uidB" (sorted).
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && chatId.split('_').hasAll(request.resource.data.members);
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /msgs/{msgId} {
        allow read: if request.auth != null && request.auth.uid in chatId.split('_');
        allow create: if request.auth != null && request.auth.uid in chatId.split('_')
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      }
    }

    // Public moments feed.
    match /moments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      // anyone can like/unlike; nothing else may change
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
